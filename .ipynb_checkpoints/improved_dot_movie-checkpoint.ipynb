    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from astropy.io import fits\\n\",\n",
    "    \"from scipy.optimize import curve_fit\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import glob\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import time\\n\",\n",
    "    \"# Added for parallel processing to speed up the loop\\n\",\n",
    "    \"from concurrent.futures import ThreadPoolExecutor\\n\",\n",
    "    \"\\n\",\n",
    "    \"#  PATHS\\n\",\n",
    "    \"target_folder = r\\\"E:\\\\Reverse Telescope Test Data\\\\20260306_data\\\\springgenie\\\\springgenie_fits\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Clean up path\\n\",\n",
    "    \"target_folder = target_folder.strip('\\\"')\\n\",\n",
    "    \"print(f\\\"Targeting folder: {target_folder}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Search\\n\",\n",
    "    \"search_path = os.path.join(target_folder, \\\"*.fits\\\")\\n\",\n",
    "    \"print(f\\\"Searching for: {search_path}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Files\\n\",\n",
    "    \"fits_list = glob.glob(search_path)\\n\",\n",
    "    \"fits_list = np.sort(fits_list)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if len(fits_list) == 0:\\n\",\n",
    "    \"    print(\\\"❌ ERROR: No files found.\\\")\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        print(\\\"\\\\nHere is what I found in that folder:\\\")\\n\",\n",
    "    \"        print(os.listdir(target_folder))\\n\",\n",
    "    \"    except:\\n\",\n",
    "    \"        print(\\\"I could not even open the folder.\\\")\\n\",\n",
    "    \"    raise SystemExit(\\\"Stopping: Check file path.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"✅ Found {len(fits_list)} files. Ready to start.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Derive folder name for saving files later\\n\",\n",
    "    \"# This grabs the folder name from your path automatically\\n\",\n",
    "    \"foldername = os.path.basename(os.path.dirname(search_path)) \\n\",\n",
    "    \"parent_folder = os.path.dirname(target_folder) # Save results one level up\\n\",\n",
    "    \"\\n\",\n",
    "    \"# DEFINITIONS & COORDINATES\\n\",\n",
    "    \"def gaussian(x, amp, mu, sigma, offset):\\n\",\n",
    "    \"    return amp * np.exp(-0.5 * ((x - mu)/sigma)**2) + offset\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Worker function so we can run multiple files at once\\n\",\n",
    "    \"def analyze_single_frame(filename):\\n\",\n",
    "    \"    \\\"\\\"\\\"Opens one file, runs math, returns results. Returns NaNs if failed.\\\"\\\"\\\"\\n\",\n",
    "    \"    dx, dy, dfx, dfy, lx, ly = np.nan, np.nan, np.nan, np.nan, np.nan, np.nan\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        with fits.open(filename) as hdul:\\n\",\n",
    "    \"            img = np.flip(hdul[0].data, axis=(0, 1))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Dot Fit\\n\",\n",
    "    \"        roi_dot = img[dot_y_slice, dot_x_slice]\\n\",\n",
    "    \"        px = np.sum(roi_dot, axis=0)\\n\",\n",
    "    \"        py = np.sum(roi_dot, axis=1)\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            popt, _ = curve_fit(gaussian, np.arange(px.size), px, p0=[px.max(), px.argmax(), 5, np.median(px)])\\n\",\n",
    "    \"            dx = popt[1] + dot_x_slice.start\\n\",\n",
    "    \"            dfx = abs(popt[2]) * 2.355\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            popt, _ = curve_fit(gaussian, np.arange(py.size), py, p0=[py.max(), py.argmax(), 5, np.median(py)])\\n\",\n",
    "    \"            dy = popt[1] + dot_y_slice.start\\n\",\n",
    "    \"            dfy = abs(popt[2]) * 2.355\\n\",\n",
    "    \"        except: pass\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Laser Fit\\n\",\n",
    "    \"        roi_las = img[laser_y_slice, laser_x_slice]\\n\",\n",
    "    \"        pxl = np.sum(roi_las, axis=0)\\n\",\n",
    "    \"        pyl = np.sum(roi_las, axis=1)\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            popt, _ = curve_fit(gaussian, np.arange(pxl.size), pxl, p0=[pxl.max(), pxl.argmax(), 20, np.median(pxl)])\\n\",\n",
    "    \"            lx = popt[1] + laser_x_slice.start\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            popt, _ = curve_fit(gaussian, np.arange(pyl.size), pyl, p0=[pyl.max(), pyl.argmax(), 20, np.median(pyl)])\\n\",\n",
    "    \"            ly = popt[1] + laser_y_slice.start\\n\",\n",
    "    \"        except: pass\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    except: pass\\n\",\n",
    "    \"    return (dx, dy, dfx, dfy, lx, ly)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# COORDINATES (Change for respective images using next code block)\\n\",\n",
    "    \"dot_x_slice = slice(1400, 1500) \\n\",\n",
    "    \"dot_y_slice = slice(580, 660)\\n\",\n",
    "    \"\\n\",\n",
    "    \"laser_x_slice = slice(1100, 1700)\\n\",\n",
    "    \"laser_y_slice = slice(750, 1300)\\n\",\n",
    "    \"use_laser = True \\n\",\n",
    "    \"\\n\",\n",
    "    \"# STREAMING ANALYSIS\\n\",\n",
    "    \"print(f\\\"Starting analysis on {len(fits_list)} files...\\\")\\n\",\n",
    "    \"start_time = time.time()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Replaced the slow loop with ThreadPoolExecutor (Parallel Processing)\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"# max_workers=16 allows 16 files to load/process simultaneously\\n\",\n",
    "    \"with ThreadPoolExecutor(max_workers=16) as executor:\\n\",\n",
    "    \"    # Map the worker function to the file list\\n\",\n",
    "    \"    for i, res in enumerate(executor.map(analyze_single_frame, fits_list)):\\n\",\n",
    "    \"        results.append(res)\\n\",\n",
    "    \"        if i % 500 == 0:\\n\",\n",
    "    \"            elapsed = time.time() - start_time\\n\",\n",
    "    \"            rate = i / (elapsed + 1e-9)\\n\",\n",
    "    \"            print(f\\\"Processed {i}/{len(fits_list)} ({rate:.1f} files/s)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Unpack the results from the parallel loop back into arrays\\n\",\n",
    "    \"results = np.array(results)\\n\",\n",
    "    \"dot_x = results[:, 0]\\n\",\n",
    "    \"dot_y = results[:, 1]\\n\",\n",
    "    \"dot_fwhm_x = results[:, 2]\\n\",\n",
    "    \"dot_fwhm_y = results[:, 3]\\n\",\n",
    "    \"laser_x = results[:, 4]\\n\",\n",
    "    \"laser_y = results[:, 5]\\n\",\n",
    "    \"np.savetxt(\\\"foldername.csv\\\", results, delimiter=\\\",\\\", header=\\\"dot_x,dot_y,dot_fwhm_x,dot_fwhm_y,laser_x,laser_y\\\", comments=\\\"\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# CALCULATE SUBTRACTION\\n\",\n",
    "    \"# Filter bad data\\n\",\n",
    "    \"mask = np.isfinite(dot_x) & np.isfinite(dot_y) & np.isfinite(laser_x) & np.isfinite(laser_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# SUBTRACT LASER DRIFT\\n\",\n",
    "    \"corrected_x_raw = dot_x[mask] - laser_x[mask]\\n\",\n",
    "    \"corrected_y_raw = dot_y[mask] - laser_y[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Recenter to 0\\n\",\n",
    "    \"# Check to ensure we actually have data before accessing index [0]\\n\",\n",
    "    \"if len(corrected_x_raw) > 0:\\n\",\n",
    "    \"    mu_x_rel = corrected_x_raw - corrected_x_raw[0]\\n\",\n",
    "    \"    mu_y_rel = corrected_y_raw - corrected_y_raw[0]\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"❌ ERROR: Math failed. All frames were bad.\\\")\\n\",\n",
    "    \"    raise SystemExit(\\\"Stopping.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Filter FWHM to match\\n\",\n",
    "    \"fwhm_x_final = dot_fwhm_x[mask]\\n\",\n",
    "    \"fwhm_y_final = dot_fwhm_y[mask]\\n\",\n",
    "    \"frames = np.arange(len(mu_x_rel))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"✅ Calculations Complete.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PLOTTING\\n\",\n",
    "    \"# Plot 1: Position\\n\",\n",
    "    \"fig, axs = plt.subplots(2, 1, figsize=(10, 8), sharex=True)\\n\",\n",
    "    \"axs[0].plot(frames, mu_x_rel, color='blue', label=\\\"Corrected X\\\")\\n\",\n",
    "    \"axs[0].set_ylabel(\\\"X Shift (px)\\\"); axs[0].legend()\\n\",\n",
    "    \"axs[0].set_title(f\\\"{foldername}: Laser-Corrected Position\\\")\\n\",\n",
    "    \"axs[1].plot(frames, mu_y_rel, color='green', label=\\\"Corrected Y\\\")\\n\",\n",
    "    \"axs[1].set_ylabel(\\\"Y Shift (px)\\\"); axs[1].set_xlabel(\\\"Frame\\\"); axs[1].legend()\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"# Save Plot 1\\n\",\n",
    "    \"save_plot_pos = os.path.join(parent_folder, foldername + \\\"_position.png\\\")\\n\",\n",
    "    \"fig.savefig(save_plot_pos)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot 2: FFT\\n\",\n",
    "    \"def compute_fft(signal, dt):\\n\",\n",
    "    \"    fft_vals = np.fft.fft(signal - np.mean(signal))\\n\",\n",
    "    \"    freqs = np.fft.fftfreq(len(signal), d=dt)\\n\",\n",
    "    \"    mask = freqs > 0\\n\",\n",
    "    \"    return freqs[mask], np.abs(fft_vals[mask])**2\\n\",\n",
    "    \"\\n\",\n",
    "    \"frame_rate = 52.37   # CHECK THIS NUMBER\\n\",\n",
    "    \"dt = 1.0 / frame_rate\\n\",\n",
    "    \"\\n\",\n",
    "    \"freqs_x, power_mu_x   = compute_fft(mu_x_rel, dt)\\n\",\n",
    "    \"freqs_y, power_mu_y   = compute_fft(mu_y_rel, dt)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axs = plt.subplots(2, 1, figsize=(10, 8))\\n\",\n",
    "    \"axs[0].plot(freqs_x, power_mu_x)\\n\",\n",
    "    \"axs[0].set_title(\\\"Vibration FFT (X)\\\")\\n\",\n",
    "    \"axs[1].plot(freqs_y, power_mu_y)\\n\",\n",
    "    \"axs[1].set_title(\\\"Vibration FFT (Y)\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save Plot 2\\n\",\n",
    "    \"save_plot_fft = os.path.join(parent_folder, foldername + \\\"_FFT.png\\\")\\n\",\n",
    "    \"fig.savefig(save_plot_fft)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# SAVE TO EXCEL\\n\",\n",
    "    \"# Saves to the parent folder (one level up from _fits)\\n\",\n",
    "    \"csv_path = os.path.join(parent_folder, \\\"collimated_beam_entry.xlsx\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    df = pd.read_excel(csv_path, engine='openpyxl')\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    df = pd.DataFrame()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Using os.path.basename to get safe filenames\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    first_file = os.path.basename(fits_list[0])\\n\",\n",
    "    \"    # Fixed the cut-off line\\n\",\n",
    "    \"    last_file = os.path.basename(fits_list[-1])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    start_t = first_file[-22:-5]\\n\",\n",
    "    \"    stop_t = last_file[-22:-5]\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    start_t = \\\"Unknown\\\"\\n\",\n",
    "    \"    stop_t = \\\"Unknown\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"new_row = {\\n\",\n",
    "    \"    'filename': foldername,\\n\",\n",
    "    \"    'frames': len(frames),\\n\",\n",
    "    \"    'frame rate': frame_rate,\\n\",\n",
    "    \"    'x pos (px)': np.nanmean(mu_x_rel),\\n\",\n",
    "    \"    'x std (px)': np.nanstd(mu_x_rel),\\n\",\n",
    "    \"    'y pos (px)': np.nanmean(mu_y_rel),\\n\",\n",
    "    \"    'y std (px)': np.nanstd(mu_y_rel),\\n\",\n",
    "    \"    'FWHM x': np.nanmean(fwhm_x_final),\\n\",\n",
    "    \"    'FWHM y': np.nanmean(fwhm_y_final)\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.concat([df, pd.DataFrame([new_row])], ignore_index=True)\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    df.to_excel(csv_path, index=False, engine='openpyxl')\\n\",\n",
    "    \"    print(f\\\"✅ Data saved to: {csv_path}\\\")\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    print(\\\"❌ ERROR: Close the Excel file and try again.\\\")\"\n",
    "   ],\n",
