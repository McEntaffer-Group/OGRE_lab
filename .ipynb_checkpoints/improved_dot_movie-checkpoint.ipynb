    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"9481dd1c\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# POST-PROCESSING ONLY (Fixes graphs & Excel)\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# CHECK IF DATA EXISTS\\n\",\n",
    "    \"if 'dot_x' not in locals():\\n\",\n",
    "    \"    raise SystemExit(\\\"❌ ERROR: Data not found in memory. You might need to rerun the analysis if the kernel restarted.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"✅ Found existing data in memory. Processing now...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# CALCULATE & CLEAN (Remove the -10,000 pixel glitches)\\n\",\n",
    "    \"# Filter bad data (NaNs)\\n\",\n",
    "    \"mask = np.isfinite(dot_x) & np.isfinite(dot_y) & np.isfinite(laser_x) & np.isfinite(laser_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Raw Subtraction\\n\",\n",
    "    \"corrected_x_raw = dot_x[mask] - laser_x[mask]\\n\",\n",
    "    \"corrected_y_raw = dot_y[mask] - laser_y[mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"if len(corrected_x_raw) > 0:\\n\",\n",
    "    \"    # Recenter first\\n\",\n",
    "    \"    mu_x_rel_raw = corrected_x_raw - corrected_x_raw[0]\\n\",\n",
    "    \"    mu_y_rel_raw = corrected_y_raw - corrected_y_raw[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # FILTER SPIKES\\n\",\n",
    "    \"    clean_mask = (np.abs(mu_x_rel_raw) < 500) & (np.abs(mu_y_rel_raw) < 500)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Apply Filter\\n\",\n",
    "    \"    mu_x_rel = mu_x_rel_raw[clean_mask]\\n\",\n",
    "    \"    mu_y_rel = mu_y_rel_raw[clean_mask]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Get matching FWHM data\\n\",\n",
    "    \"    fwhm_x_final = dot_fwhm_x[mask][clean_mask]\\n\",\n",
    "    \"    fwhm_y_final = dot_fwhm_y[mask][clean_mask]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    frames = np.arange(len(mu_x_rel))\\n\",\n",
    "    \"    print(f\\\"✅ Data Cleaned. Removed {np.sum(~clean_mask)} glitch frames.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"❌ ERROR: Math failed. All frames were bad.\\\")\\n\",\n",
    "    \"    raise SystemExit(\\\"Stopping.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PLOT 1: POSITION (Cleaned)\\n\",\n",
    "    \"fig, axs = plt.subplots(2, 1, figsize=(10, 8), sharex=True)\\n\",\n",
    "    \"axs[0].plot(frames, mu_x_rel, color='blue', label=\\\"Corrected X\\\")\\n\",\n",
    "    \"axs[0].set_ylabel(\\\"X Shift (px)\\\"); axs[0].legend()\\n\",\n",
    "    \"axs[0].set_title(f\\\"{foldername}: Laser-Corrected Position (Cleaned)\\\")\\n\",\n",
    "    \"axs[1].plot(frames, mu_y_rel, color='green', label=\\\"Corrected Y\\\")\\n\",\n",
    "    \"axs[1].set_ylabel(\\\"Y Shift (px)\\\"); axs[1].set_xlabel(\\\"Frame\\\"); axs[1].legend()\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"fig.savefig(os.path.join(parent_folder, foldername + \\\"_position_cleaned.png\\\"))\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PLOT 2: FWHM\\n\",\n",
    "    \"fig, axs = plt.subplots(2, 1, figsize=(10, 8), sharex=True)\\n\",\n",
    "    \"axs[0].plot(frames, fwhm_x_final, color='orange', label=\\\"FWHM X\\\")\\n\",\n",
    "    \"axs[0].set_ylabel(\\\"Width (px)\\\"); axs[0].legend()\\n\",\n",
    "    \"axs[0].set_title(f\\\"{foldername}: Dot Focus Stability\\\")\\n\",\n",
    "    \"axs[1].plot(frames, fwhm_y_final, color='red', label=\\\"FWHM Y\\\")\\n\",\n",
    "    \"axs[1].set_ylabel(\\\"Width (px)\\\"); axs[1].set_xlabel(\\\"Frame\\\"); axs[1].legend()\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"fig.savefig(os.path.join(parent_folder, foldername + \\\"_FWHM.png\\\"))\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# PLOT 3: FFT\\n\",\n",
    "    \"def compute_fft(signal, dt):\\n\",\n",
    "    \"    fft_vals = np.fft.fft(signal - np.mean(signal))\\n\",\n",
    "    \"    freqs = np.fft.fftfreq(len(signal), d=dt)\\n\",\n",
    "    \"    mask = freqs > 0\\n\",\n",
    "    \"    return freqs[mask], np.abs(fft_vals[mask])**2\\n\",\n",
    "    \"\\n\",\n",
    "    \"frame_rate = 0.016666667  \\n\",\n",
    "    \"dt = 1.0 / frame_rate\\n\",\n",
    "    \"freqs_x, power_mu_x   = compute_fft(mu_x_rel, dt)\\n\",\n",
    "    \"freqs_y, power_mu_y   = compute_fft(mu_y_rel, dt)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axs = plt.subplots(2, 1, figsize=(10, 8))\\n\",\n",
    "    \"axs[0].plot(freqs_x, power_mu_x)\\n\",\n",
    "    \"axs[0].set_title(\\\"Vibration FFT (X)\\\")\\n\",\n",
    "    \"axs[1].plot(freqs_y, power_mu_y)\\n\",\n",
    "    \"axs[1].set_title(\\\"Vibration FFT (Y)\\\")\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"fig.savefig(os.path.join(parent_folder, foldername + \\\"_FFT.png\\\"))\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 6. SAVE TO EXCEL (Fixed Columns)\\n\",\n",
    "    \"csv_path = os.path.join(parent_folder, \\\"collimated_beam_entry.xlsx\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    df = pd.read_excel(csv_path, engine='openpyxl')\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    df = pd.DataFrame()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Metadata\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    first_file = os.path.basename(fits_list[0])\\n\",\n",
    "    \"    last_file = os.path.basename(fits_list[-1])\\n\",\n",
    "    \"    start_t = first_file[-22:-5]\\n\",\n",
    "    \"    stop_t = last_file[-22:-5]\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    start_t = \\\"Unknown\\\"; stop_t = \\\"Unknown\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dictionary with YOUR EXACT COLUMN NAMES\\n\",\n",
    "    \"new_row = {\\n\",\n",
    "    \"    'filename': foldername,\\n\",\n",
    "    \"    'number of frames': len(frames),\\n\",\n",
    "    \"    'start time': start_t,\\n\",\n",
    "    \"    'stop time': stop_t,\\n\",\n",
    "    \"    'notes': \\\"Parallel Analysis (Cleaned)\\\",\\n\",\n",
    "    \"    'frame rate': frame_rate,\\n\",\n",
    "    \"    'x position': np.nanmean(mu_x_rel),\\n\",\n",
    "    \"    'x position std': np.nanstd(mu_x_rel),\\n\",\n",
    "    \"    'y position': np.nanmean(mu_y_rel),\\n\",\n",
    "    \"    'y position std': np.nanstd(mu_y_rel),\\n\",\n",
    "    \"    'FWHM x': np.nanmean(fwhm_x_final),\\n\",\n",
    "    \"    'FWHM x std': np.nanstd(fwhm_x_final),\\n\",\n",
    "    \"    'FWHM y': np.nanmean(fwhm_y_final),\\n\",\n",
    "    \"    'FWHM y std': np.nanstd(fwhm_y_final)\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.concat([df, pd.DataFrame([new_row])], ignore_index=True)\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    df.to_excel(csv_path, index=False, engine='openpyxl')\\n\",\n",
    "    \"    print(f\\\"✅ Data saved to: {csv_path}\\\")\\n\",\n",
    "    \"except:\\n\",\n",
    "    \"    print(\\\"❌ ERROR: Close the Excel file and try again.\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"5b9d7730\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import matplotlib.animation as animation\\n\",\n",
    "    \"from IPython.display import HTML\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from astropy.io import fits\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"\\n\",\n",
    "    \"# VIDEO SETTINGS\\n\",\n",
    "    \"DECIMATION = 200  # Skip frames to speed up rendering (Try 5 or 10)\\n\",\n",
    "    \"video_indices = np.arange(0, len(fits_list), DECIMATION)\\n\",\n",
    "    \"# save_video_path = os.path.join(parent_folder, foldername + \\\"_profile_analysis.mp4\\\")\\n\",\n",
    "    \"save_video_path = os.path.join(parent_folder, foldername + \\\"_profile_analysis.gif\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Initializing Profile Video... ({len(video_indices)} frames)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig = plt.figure(figsize=(12, 10))\\n\",\n",
    "    \"# Grid: Top-Left (Profiles), Bottom-Right (Image)\\n\",\n",
    "    \"gs = fig.add_gridspec(2, 2, width_ratios=[4, 1], height_ratios=[1, 4], wspace=0.0, hspace=0.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax_img = fig.add_subplot(gs[1, 0])\\n\",\n",
    "    \"ax_x   = fig.add_subplot(gs[0, 0], sharex=ax_img)\\n\",\n",
    "    \"ax_y   = fig.add_subplot(gs[1, 1], sharey=ax_img)\\n\",\n",
    "    \"fig.add_subplot(gs[0, 1]).axis(\\\"off\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load first frame to set scaling\\n\",\n",
    "    \"with fits.open(fits_list[0]) as hdul:\\n\",\n",
    "    \"    first_data = np.flip(hdul[0].data, axis=(0, 1))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# MAIN IMAGE\\n\",\n",
    "    \"vmin, vmax = np.percentile(first_data, 1), np.percentile(first_data, 99)\\n\",\n",
    "    \"im = ax_img.imshow(first_data, cmap=\\\"viridis\\\", origin=\\\"lower\\\", vmin=vmin, vmax=vmax, aspect=\\\"auto\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Markers for Dot (Green) and Laser (Red)\\n\",\n",
    "    \"dot_mark, = ax_img.plot([], [], 'g+', ms=15, markeredgewidth=2, label=\\\"Dot Center\\\")\\n\",\n",
    "    \"las_mark, = ax_img.plot([], [], 'rx', ms=15, markeredgewidth=2, label=\\\"Laser Center\\\")\\n\",\n",
    "    \"ax_img.legend(loc=\\\"upper right\\\", fontsize=9, framealpha=0.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# X-PROFILE (Top Graph)\\n\",\n",
    "    \"profile_x_data = np.sum(first_data, axis=0)\\n\",\n",
    "    \"line_x, = ax_x.plot(np.arange(first_data.shape[1]), profile_x_data, 'k-', lw=1)\\n\",\n",
    "    \"# Vertical lines showing calculated centers\\n\",\n",
    "    \"vline_dot_x = ax_x.axvline(x=0, color='g', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"vline_las_x = ax_x.axvline(x=0, color='r', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Y-PROFILE (Right Graph)\\n\",\n",
    "    \"profile_y_data = np.sum(first_data, axis=1)\\n\",\n",
    "    \"line_y, = ax_y.plot(profile_y_data, np.arange(first_data.shape[0]), 'k-', lw=1)\\n\",\n",
    "    \"# Horizontal lines showing calculated centers\\n\",\n",
    "    \"hline_dot_y = ax_y.axhline(y=0, color='g', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"hline_las_y = ax_y.axhline(y=0, color='r', linestyle='--', alpha=0.7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Formatting axes\\n\",\n",
    "    \"ax_x.set_xlim(0, first_data.shape[1])\\n\",\n",
    "    \"ax_y.set_ylim(0, first_data.shape[0])\\n\",\n",
    "    \"ax_x.tick_params(labelbottom=False)\\n\",\n",
    "    \"ax_y.tick_params(labelleft=False)\\n\",\n",
    "    \"ax_x.set_ylabel(\\\"Sum Counts\\\")\\n\",\n",
    "    \"ax_y.set_xlabel(\\\"Sum Counts\\\")\\n\",\n",
    "    \"ax_x.grid(True, alpha=0.3)\\n\",\n",
    "    \"ax_y.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Correlation/Deviation\\n\",\n",
    "    \"stats_text = ax_img.text(\\n\",\n",
    "    \"    0.02, 0.98, \\\"\\\", \\n\",\n",
    "    \"    transform=ax_img.transAxes, \\n\",\n",
    "    \"    color=\\\"white\\\", fontsize=12, verticalalignment=\\\"top\\\",\\n\",\n",
    "    \"    bbox=dict(facecolor=\\\"black\\\", alpha=0.6, edgecolor=\\\"none\\\", pad=4)\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ANIMATION LOOP\\n\",\n",
    "    \"\\n\",\n",
    "    \"def update(frame_idx):\\n\",\n",
    "    \"    # 'frame_idx' is the index in our DECIMATED list, not the file index\\n\",\n",
    "    \"    real_idx = video_indices[frame_idx]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Load Data directly \\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        with fits.open(fits_list[real_idx]) as hdul:\\n\",\n",
    "    \"            img = np.flip(hdul[0].data, axis=(0, 1))\\n\",\n",
    "    \"    except:\\n\",\n",
    "    \"        return [im]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Update Image\\n\",\n",
    "    \"    im.set_array(img)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Update Profiles\\n\",\n",
    "    \"    prof_x = np.sum(img, axis=0)\\n\",\n",
    "    \"    prof_y = np.sum(img, axis=1)\\n\",\n",
    "    \"    line_x.set_ydata(prof_x)\\n\",\n",
    "    \"    line_y.set_xdata(prof_y)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Auto-scale profile views if intensity changes drastically\\n\",\n",
    "    \"    if frame_idx % 20 == 0:\\n\",\n",
    "    \"        ax_x.set_ylim(0, np.max(prof_x)*1.1)\\n\",\n",
    "    \"        ax_y.set_xlim(0, np.max(prof_y)*1.1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Get Calculated Positions (Using the raw arrays from previous code block)\\n\",\n",
    "    \"    # Check if we have valid data for this frame\\n\",\n",
    "    \"    dx, dy = dot_x[real_idx], dot_y[real_idx]\\n\",\n",
    "    \"    lx, ly = laser_x[real_idx], laser_y[real_idx]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Update Markers on Image\\n\",\n",
    "    \"    dot_mark.set_data([dx], [dy])\\n\",\n",
    "    \"    las_mark.set_data([lx], [ly])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Update Guide Lines on Graphs\\n\",\n",
    "    \"    vline_dot_x.set_xdata([dx])\\n\",\n",
    "    \"    vline_las_x.set_xdata([lx])\\n\",\n",
    "    \"    hline_dot_y.set_ydata([dy])\\n\",\n",
    "    \"    hline_las_y.set_ydata([ly])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Update Text (Correlation)\\n\",\n",
    "    \"    if np.isfinite(dx) and np.isfinite(lx):\\n\",\n",
    "    \"        shift_x = dx - lx\\n\",\n",
    "    \"        shift_y = dy - ly\\n\",\n",
    "    \"        msg = (f\\\"Frame: {real_idx}\\\\n\\\"\\n\",\n",
    "    \"               f\\\"Dot: ({dx:.1f}, {dy:.1f})\\\\n\\\"\\n\",\n",
    "    \"               f\\\"Laser: ({lx:.1f}, {ly:.1f})\\\\n\\\"\\n\",\n",
    "    \"               f\\\"-----------------\\\\n\\\"\\n\",\n",
    "    \"               f\\\"SHIFT X: {shift_x:.2f} px\\\\n\\\"\\n\",\n",
    "    \"               f\\\"SHIFT Y: {shift_y:.2f} px\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        msg = f\\\"Frame: {real_idx}\\\\n(Fit Failed)\\\"\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    stats_text.set_text(msg)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return [im, line_x, line_y, dot_mark, las_mark, \\n\",\n",
    "    \"            vline_dot_x, vline_las_x, hline_dot_y, hline_las_y, stats_text]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Run Animation\\n\",\n",
    "    \"ani = animation.FuncAnimation(fig, update, frames=len(video_indices), interval=50, blit=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save Video\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    print(\\\"Saving video\\\")\\n\",\n",
    "    \"    # Try FFMPEG first (Faster, better quality)\\n\",\n",
    "    \"    writer = animation.FFMpegWriter(fps=30, bitrate=3000)\\n\",\n",
    "    \"    ani.save(save_video_path, writer=writer)\\n\",\n",
    "    \"except Exception as e:\\n\",\n",
    "    \"    print(f\\\"⚠️ FFMPEG failed ({e}). Switching to 'Pillow'\\\")\\n\",\n",
    "    \"    ani.save(save_video_path, writer='pillow', fps=30)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Video Saved: {save_video_path}\\\")\\n\",\n",
    "    \"plt.close()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"6703a59e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import matplotlib.patches as patches\\n\",\n",
    "    \"from astropy.io import fits\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# NEW TIGHTER COORDINATES (Try these!)\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# I shrank the box from 100px wide to 60px wide to exclude the laser\\n\",\n",
    "    \"dot_x_slice = slice(1415, 1475) \\n\",\n",
    "    \"dot_y_slice = slice(590, 650)   \\n\",\n",
    "    \"\\n\",\n",
    "    \"# Keep Laser the same\\n\",\n",
    "    \"laser_x_slice = slice(1100, 1700)\\n\",\n",
    "    \"laser_y_slice = slice(750, 1300)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# VISUAL CHECK\\n\",\n",
    "    \"# ==========================================\\n\",\n",
    "    \"# Open the first file\\n\",\n",
    "    \"with fits.open(fits_list[0]) as hdul:\\n\",\n",
    "    \"    data = np.flip(hdul[0].data, axis=(0, 1))\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 10))\\n\",\n",
    "    \"# Boost contrast so we can see the faint dot\\n\",\n",
    "    \"vmin, vmax = np.percentile(data, 1), np.percentile(data, 99.5)\\n\",\n",
    "    \"ax.imshow(data, cmap='viridis', origin='lower', vmin=vmin, vmax=vmax)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Draw the Search Boxes\\n\",\n",
    "    \"# Dot Box (White)\\n\",\n",
    "    \"rect_dot = patches.Rectangle((dot_x_slice.start, dot_y_slice.start), \\n\",\n",
    "    \"                             dot_x_slice.stop - dot_x_slice.start,\\n\",\n",
    "    \"                             dot_y_slice.stop - dot_y_slice.start,\\n\",\n",
    "    \"                             linewidth=2, edgecolor='white', facecolor='none', label='Dot Search Area')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Laser Box (Red)\\n\",\n",
    "    \"rect_las = patches.Rectangle((laser_x_slice.start, laser_y_slice.start), \\n\",\n",
    "    \"                             laser_x_slice.stop - laser_x_slice.start,\\n\",\n",
    "    \"                             laser_y_slice.stop - laser_y_slice.start,\\n\",\n",
    "    \"                             linewidth=2, edgecolor='red', facecolor='none', linestyle='--', label='Laser Search Area')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.add_patch(rect_dot)\\n\",\n",
    "    \"ax.add_patch(rect_las)\\n\",\n",
    "    \"ax.legend()\\n\",\n",
    "    \"ax.set_title(\\\"CHECK: Is the Dot inside the White Box?\\\\nIs the Laser OUTSIDE the White Box?\\\")\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null\n",
    "  }\n",
