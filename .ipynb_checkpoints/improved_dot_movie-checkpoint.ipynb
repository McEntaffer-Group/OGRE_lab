    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from astropy.io import fits\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load the first file from your list\\n\",\n",
    "    \"with fits.open(fits_list[0]) as hdul:\\n\",\n",
    "    \"    data = np.flip(hdul[0].data, axis=(0, 1)) # Flip to match your analysis code\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot it so you can find the coordinates for slice\\n\",\n",
    "    \"plt.figure(figsize=(10, 10))\\n\",\n",
    "    \"plt.imshow(data, cmap='viridis', vmin=0, vmax=np.percentile(data, 99))\\n\",\n",
    "    \"plt.title(\\\"HOVER over the DOT and LASER to see X/Y coordinates\\\")\\n\",\n",
    "    \"plt.grid(True, color='white', alpha=0.3)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
